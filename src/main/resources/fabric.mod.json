{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "輝煌伺服器（brilliantw.net）專屬客戶端模組：Discord 遊玩狀態、可搜尋的聊天欄選單、公告與官網、頻道分頁、私訊視窗、自動腳本、指令別名，以及更多便利功能。",
	"authors": [
		"ricechen_"
	],
	"contact": {
		"homepage": "https://www.brilliantw.net",
		"sources": "https://github.com/BrilliantTeam/brilliant-server-mod",
		"issues": "https://github.com/BrilliantTeam/brilliant-server-mod/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/brilliant-server-mod/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.brilliantw.richpresence.RichPresenceModClient"
		]
	},
	"mixins": [
		"brilliant-server-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "${minecraft}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.brilliantw.net/"
			}
		}
	}
}
