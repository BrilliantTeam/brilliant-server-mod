{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "輝煌伺服器（brilliantw.net）專屬客戶端模組：Discord 遊玩狀態、小地圖與大地圖、仿 Discord 的表情與貼圖選單、可搜尋的聊天欄選單、頻道分頁、私訊視窗、自動腳本、快捷鍵與指令別名，以及更多便利功能。",
	"authors": [
		"ricechen_"
	],
	"contact": {
		"homepage": "https://www.brilliantw.net/mod/",
		"issues": "https://discord.brilliantw.net/"
	},
	"license": "LicenseRef-All-Rights-Reserved",
	"icon": "assets/brilliant-server-mod/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.brilliantw.richpresence.RichPresenceModClient"
		],
		"modmenu": [
			"net.brilliantw.richpresence.ModMenuIntegration"
		]
	},
	"mixins": [
		"brilliant-server-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "${minecraft}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.brilliantw.net/"
			}
		}
	}
}
